[
  {
    "type": "function",
    "function": {
      "name": "listar_leads",
      "description": "Lista leads do CRM com filtros (estágio, cidade, segmento, tag, busca, sem contato há N dias). Use para encontrar leads para enriquecer ou acompanhar. [GET /leads]",
      "parameters": {
        "type": "object",
        "properties": {
          "estagio": {
            "type": "string",
            "enum": [
              "novo",
              "abordado",
              "respondeu",
              "auditoria_enviada",
              "proposta_enviada",
              "negociacao",
              "ganho",
              "perdido",
              "sem_resposta"
            ],
            "description": "Filtra por estágio."
          },
          "cidade": {
            "type": "string",
            "description": "Cidade exata."
          },
          "segmento": {
            "type": "string",
            "description": "Segmento exato."
          },
          "tag": {
            "type": "string",
            "description": "Leads que têm esta tag."
          },
          "busca": {
            "type": "string",
            "description": "Busca em empresa, contato, cidade e telefone."
          },
          "sem_contato_ha_dias": {
            "type": "integer",
            "minimum": 0,
            "description": "Sem contato há pelo menos N dias (inclui nunca contatados)."
          },
          "atualizado_desde": {
            "type": "string",
            "description": "Só leads alterados desde esta data (ISO 8601)."
          },
          "incluir_arquivados": {
            "type": "boolean",
            "description": "true para incluir arquivados."
          },
          "limite": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "Itens por página (1 a 200, padrão 50)."
          },
          "cursor": {
            "type": "string",
            "description": "Valor de \"proximo_cursor\" da página anterior."
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "x-http": {
      "metodo": "GET",
      "rota": "/leads",
      "escopo": "leitura"
    }
  },
  {
    "type": "function",
