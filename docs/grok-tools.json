    "type": "function",
    "function": {
      "name": "propor_acao",
      "description": "Propõe uma ação para o Richard aprovar em 1 toque (mensagem, mudança de estágio, venda ou outra). Sempre explique a justificativa. [POST /acoes-pendentes]",
      "parameters": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "enviar_mensagem",
              "mudar_estagio",
              "criar_venda",
              "outro"
            ]
          },
          "lead_id": {
            "type": "string",
            "description": "Obrigatório exceto para \"outro\"."
          },
