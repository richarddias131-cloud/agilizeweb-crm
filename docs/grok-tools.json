              "null"
            ],
            "description": "Sigla do estado."
          },
          "segmento": {
            "type": [
              "string",
              "null"
            ],
            "description": "Segmento (ex.: Ótica, Estética automotiva)."
          },
          "origem": {
            "type": "string",
            "enum": [
              "prospeccao_ativa",
              "indicacao",
              "instagram",
              "site",
              "importacao",
              "agente"
            ],
            "description": "Padrão: agente."
          },
          "link_google": {
            "type": [
              "string",
              "null"
            ],
            "description": "Link do Perfil do Google / Maps."
